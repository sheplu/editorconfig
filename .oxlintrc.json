{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "error",
    "perf": "error",
    "style": "error",
    "restriction": "error"
  },
  "rules": {
    "func-style": "off",
    "sort-imports": "off",
    "sort-keys": "off",
    "no-async-await": "off",
    "unicorn/import-style": ["error", { "styles": { "node:path": { "named": true } } }],
    "no-magic-numbers": ["error", { "ignore": [-1, 0, 1, 2], "ignoreArrayIndexes": true, "enforceConst": true }]
  },
  "env": {
    "builtin": true
  },
  "overrides": [
    {
      "files": ["test/**"],
      "rules": {
        "no-magic-numbers": "off"
      }
    }
  ]
}
